{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/felixkwasisarpong/incident-triage-mcp/spec/evidence-bundle.v1.schema.json",
  "title": "EvidenceBundle v1",
  "description": "Canonical incident evidence artifact shared between Airflow evidence workflows and MCP tools.",
  "type": "object",
  "required": [
    "schema_version",
    "incident_id",
    "service",
    "time_window",
    "generated_at_iso"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "v1"
    },
    "incident_id": {
      "type": "string",
      "minLength": 1
    },
    "service": {
      "type": "string",
      "minLength": 1
    },
    "time_window": {
      "type": "object",
      "required": ["start_iso", "end_iso"],
      "properties": {
        "start_iso": {
          "type": "string",
          "format": "date-time"
        },
        "end_iso": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": true
    },
    "generated_at_iso": {
      "type": "string",
      "format": "date-time"
    },
    "alerts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status", "priority", "provider"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "value"],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "value": {}
        },
        "additionalProperties": true
      }
    },
    "runbook_hits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["doc_id", "title", "score", "summary"],
        "properties": {
          "doc_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "score": {
            "type": "number"
          },
          "summary": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "url"],
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommended_next_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
