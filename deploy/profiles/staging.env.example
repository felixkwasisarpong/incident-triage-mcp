# Staging profile (real transport/auth, mix of real providers)
DEPLOYMENT_PROFILE=staging

MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=3333
AUDIT_MODE=stdout

MCP_HTTP_AUTH_MODE=api_key
MCP_HTTP_API_KEY=CHANGE_ME_STAGING_KEY

EVIDENCE_BACKEND=s3
S3_ENDPOINT_URL=https://s3-staging.example.com
S3_BUCKET=incident-triage-staging
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=CHANGE_ME_STAGING_AWS_KEY
AWS_SECRET_ACCESS_KEY=CHANGE_ME_STAGING_AWS_SECRET

RUNBOOKS_DIR=./runbooks
MCP_ROLE=responder
CONFIRM_TOKEN=CHANGE_ME_STAGING_CONFIRM_TOKEN

JIRA_PROVIDER=cloud
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=incident-bot@example.com
JIRA_API_TOKEN=CHANGE_ME_STAGING_JIRA_TOKEN
JIRA_PROJECT_KEY=INC
JIRA_ISSUE_TYPE=Task
# Alternate ticket provider:
# JIRA_PROVIDER=servicenow
# SERVICENOW_BASE_URL=https://acme-staging.service-now.com
# SERVICENOW_USERNAME=incident_bot
# SERVICENOW_PASSWORD=CHANGE_ME_STAGING_SNOW_PASSWORD
# SERVICENOW_TABLE=incident

ALERTS_PROVIDER=datadog
METRICS_PROVIDER=datadog
LOGS_PROVIDER=elk
TRACES_PROVIDER=xray
DATADOG_API_KEY=CHANGE_ME_STAGING_DATADOG_API_KEY
DATADOG_APP_KEY=CHANGE_ME_STAGING_DATADOG_APP_KEY
ELASTICSEARCH_BASE_URL=https://es-staging.example.com

IDEMPOTENCY_BACKEND=redis
IDEMPOTENCY_REDIS_URL=redis://redis-staging:6379/0
