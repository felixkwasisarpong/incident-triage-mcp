# Local development profile (safe defaults, mock-first)
DEPLOYMENT_PROFILE=local

MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=3333
AUDIT_MODE=stdout

EVIDENCE_BACKEND=fs
EVIDENCE_DIR=./evidence
RUNBOOKS_DIR=./runbooks

MCP_ROLE=responder
CONFIRM_TOKEN=CHANGE_ME_12345

JIRA_PROVIDER=mock
JIRA_PROJECT_KEY=INC
JIRA_ISSUE_TYPE=Task

NOTIFY_PROVIDER=slack
SLACK_WEBHOOK_URL=
SLACK_DEFAULT_CHANNEL=#incident-triage
TEAMS_WEBHOOK_URL=
TEAMS_DEFAULT_CHANNEL="Incident Triage"

ALERTS_PROVIDER=mock
METRICS_PROVIDER=mock
LOGS_PROVIDER=mock
TRACES_PROVIDER=mock

IDEMPOTENCY_BACKEND=file
IDEMPOTENCY_STORE_PATH=./data/jira_idempotency.json
