# Production profile (strict settings)
DEPLOYMENT_PROFILE=prod

MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=3333
AUDIT_MODE=stdout

MCP_HTTP_AUTH_MODE=jwt_hs256
MCP_HTTP_JWT_SECRET=CHANGE_ME_PROD_JWT_SECRET
MCP_HTTP_JWT_ISSUER=incident-triage-auth
MCP_HTTP_JWT_AUDIENCE=incident-triage-mcp
MCP_HTTP_JWT_LEEWAY_SECONDS=30

EVIDENCE_BACKEND=s3
S3_ENDPOINT_URL=https://s3.amazonaws.com
S3_BUCKET=incident-triage-prod
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=CHANGE_ME_PROD_AWS_KEY
AWS_SECRET_ACCESS_KEY=CHANGE_ME_PROD_AWS_SECRET

RUNBOOKS_DIR=/app/runbooks
MCP_ROLE=admin
CONFIRM_TOKEN=CHANGE_ME_PROD_CONFIRM_TOKEN

JIRA_PROVIDER=cloud
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=incident-bot@example.com
JIRA_API_TOKEN=CHANGE_ME_PROD_JIRA_TOKEN
JIRA_PROJECT_KEY=INC
JIRA_ISSUE_TYPE=Task
# Alternate ticket provider:
# JIRA_PROVIDER=servicenow
# SERVICENOW_BASE_URL=https://acme.service-now.com
# SERVICENOW_USERNAME=incident_bot
# SERVICENOW_PASSWORD=CHANGE_ME_PROD_SNOW_PASSWORD
# SERVICENOW_TABLE=incident

NOTIFY_PROVIDER=slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/CHANGE_ME/PROD/WEBHOOK
SLACK_DEFAULT_CHANNEL=#incident-triage
# NOTIFY_PROVIDER=teams
# TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/CHANGE_ME/PROD
# TEAMS_DEFAULT_CHANNEL="Incident Triage"

# In prod, alerts/metrics should be non-mock.
ALERTS_PROVIDER=cloudwatch
METRICS_PROVIDER=cloudwatch
LOGS_PROVIDER=elk
TRACES_PROVIDER=xray
ELASTICSEARCH_BASE_URL=https://es-prod.example.com

IDEMPOTENCY_BACKEND=postgres
IDEMPOTENCY_POSTGRES_DSN=postgresql://incident_triage:CHANGE_ME@postgres-prod:5432/incident_triage
IDEMPOTENCY_POSTGRES_TABLE=jira_idempotency
